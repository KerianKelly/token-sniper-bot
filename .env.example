# Paper mode unless this is exactly "true". Paper mode detects, builds and simulates buys but never sends.
LIVE=false
TARGETS_FILE=targets.json

# ---------- Solana (Perpspad) ----------
# Use a FRESH hot wallet holding only what you intend to snipe with. Base58 secret key.
SOLANA_PRIVATE_KEY=
# Paid RPC strongly recommended (Helius / QuickNode / Triton). Public RPC works for paper testing only.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
# Websocket(s) for launch detection via logsSubscribe, comma-separated; they race and the first wins.
# e.g. wss://mainnet.helius-rpc.com/?api-key=KEY,wss://api.mainnet-beta.solana.com
SOLANA_WATCH_WS_URL=wss://api.mainnet-beta.solana.com
# Backup detector: poll each deployer's signatures on SOLANA_RPC_URL every N ms (0 = off).
# Alchemy free tier rate-limits at 1000ms for a single wallet; Helius handled 500ms cleanly.
SOLANA_SIGNATURE_POLL_MS=2000
# Yellowstone/Geyser gRPC ONLY (Helius LaserStream, QuickNode, Triton). A normal RPC URL will not work here.
# Without it the bot uses the websocket + polling detectors above (~0.5-1s slower).
SOLANA_GRPC_URL=
SOLANA_GRPC_TOKEN=
SOLANA_PRIORITY_FEE_MICROLAMPORTS=2000000
SOLANA_COMPUTE_UNITS=250000
JITO_TIP_LAMPORTS=1000000
JITO_URL=https://mainnet.block-engine.jito.wtf
# Jupiter aggregator, used when a curve is already complete at launch (migrated coins).
JUPITER_URL=https://lite-api.jup.ag

# ---------- Robinhood Chain (Perpshood / Pons) ----------
# Fresh hot wallet, 0x-prefixed hex private key.
ROBINHOOD_PRIVATE_KEY=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_FEED_URL=wss://feed.mainnet.chain.robinhood.com
# getLogs fallback watcher. Public RPC by default (no 10-block cap, doesn't use your paid quota).
ROBINHOOD_LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_LOGS_POLL_MS=1000
# Blocks per eth_getLogs request. Set to 10 if ROBINHOOD_LOGS_RPC_URL is an Alchemy free-tier URL.
ROBINHOOD_LOGS_MAX_RANGE=2000
# Optional websocket RPC (e.g. Alchemy) for log push; public RPC has none, so HTTP polling is used.
ROBINHOOD_WS_URL=
ROBINHOOD_GAS_LIMIT=600000
ROBINHOOD_FEE_MULTIPLIER=3
# How often to re-read the anti-snipe tax while waiting for it to drop.
ROBINHOOD_POLL_MS=100

# ---------- Robinhood Chain presales (daos.world, e.g. PaperDAO) ----------
# Comma-separated private keys of the whitelisted wallets. Each deposits its own tier allocation
# (0x5b1f… PaperDAO: tier 2 = 0.1 ETH, tier 3 = 0.025 ETH) as soon as its whitelist batch lands.
ROBINHOOD_PRESALE_KEYS=
